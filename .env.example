# Copy to .env and fill in. Nothing here is required to start —
# Hacker News and Stack Exchange work with no keys at all.

# Reddit — free. Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=elhg-finder/0.1 by u/yourusername

# Search API for Quora / JustAnswer — pick ONE.
# Brave:  https://brave.com/search/api/       (2,000 free queries/month)
# Serper: https://serper.dev/                 (2,500 free credits)
# Google: https://developers.google.com/custom-search/v1/overview  (100/day free)
BRAVE_API_KEY=
# SERPER_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# Claude — for clustering findings into market opportunities.
ANTHROPIC_API_KEY=
